<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>SwarmUI-RefModExtension</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- This is the normal extension build contract when installed in SwarmUI/src/Extensions. -->
  <Import Project="../../SwarmUI.extension.props" Condition="Exists('../../SwarmUI.extension.props')" />

  <ItemGroup Condition="'$(DesignTimeBuild)' == 'true' and Exists('../../SwarmUI.csproj')">
    <Reference Remove="SwarmUI" />
    <ProjectReference Include="../../SwarmUI.csproj">
      <Private>false</Private>
      <Properties>_EnableMacOSCodeSign=false</Properties>
    </ProjectReference>
  </ItemGroup>

  <!-- Lets this standalone checkout compile against the supplied SwarmUI source.
       This condition is false after the project is placed in src/Extensions. -->
  <ItemGroup Condition="!Exists('../../SwarmUI.extension.props') and Exists('../Reference/SwarmUI/src/SwarmUI.csproj')">
    <ProjectReference Include="../Reference/SwarmUI/src/SwarmUI.csproj">
      <Private>false</Private>
      <Properties>_EnableMacOSCodeSign=false</Properties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin/**/*.cs" />
    <Compile Remove="obj/**/*.cs" />
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="**/._*" />
  </ItemGroup>

</Project>
